#!/bin/bash
# go2v2: la v2 del Go2 (stack de CMU + go2_v2) en Docker. Ver README.md.
set -u
AQUI="$(cd "$(dirname "$(readlink -f "${BASH_SOURCE[0]}")")" && pwd)"
IMAGEN=go2v2
NOMBRE=go2v2
DATOS="$HOME/.go2_v2"
mkdir -p "$DATOS/Desktop" "$DATOS/bags"

rojo() { printf "\033[1;31m%s\033[0m\n" "$*"; }
verde() { printf "\033[1;32m%s\033[0m\n" "$*"; }
amarillo() { printf "\033[1;33m%s\033[0m\n" "$*"; }

ayuda() {
  cat <<'TXT'
go2v2 - el Go2 con el stack de CMU (Point-LIO + planificador local a 100 Hz + FAR planner)

  PRIMERA VEZ
    go2v2 instalar              construye la imagen Docker (~15-25 min la primera vez)
    go2v2 red                   ajusta el buffer de red de Linux para las nubes del L1 (sudo, una vez)
    go2v2 calibrar              calibra la IMU del L1 (UNA vez por perro). El perro DE PIE y con
                                ~1 m libre alrededor: da pasitos 2 s, quieto 10 s y gira 20 s

  USO
    go2v2 lanzar                todo: SLAM + evasion + rutas (FAR) + RViz
        ruta:=false             sin FAR (solo el planificador local: metas cercanas)
        velocidad:=0.8          tope en m/s (por defecto 1.0)
        rviz:=false
    go2v2 ir X Y | ir NOMBRE    ir a un punto (metros desde donde arranco el perro)
    go2v2 guardar NOMBRE        guardar donde esta el perro
    go2v2 puntos | borrar NOMBRE
    go2v2 parar                 corta la navegacion (queda quieto)
    go2v2 pausa                 freno de emergencia (otra vez para seguir) = CIRCULO del PS4
    go2v2 acostar | levantar | bloquear | desbloquear
    go2v2 recuperar             se cayo o quedo raro: RecoveryStand
    go2v2 estado                sensores, guardian, pose, demora
    go2v2 log                   ultimos mensajes
    go2v2 grabar [s]            graba /utlidar/cloud + /utlidar/imu (para revisar sin el perro)
    go2v2 detener               apaga todo

  SIMULADOR (sin perro: el entorno 3D de CMU)
    go2v2 sim-instalar ARCHIVO  instala el entorno de Unity bajado de CMU (.zip o .tar.gz)
    go2v2 sim                   lo mismo que 'lanzar' pero con un perro simulado en Unity
        ruta:=false  velocidad:=0.8  rviz:=false
                                (con la v2 en sim, ir/guardar/parar/pausa/estado funcionan igual)
    go2v2 shell                 una terminal dentro del Docker

  CONTROL PS4 (por Bluetooth o USB)
    stick derecho               manejar: el perro sigue la direccion y ESQUIVA solo
    L2 sostenido                modo autonomo (sigue la meta)      R2 sostenido: manual SIN evasion
    R1                          borrar el mapa de terreno (si quedo basura)
    L1                          borrar el grafo de rutas de FAR (empieza de cero)
    CIRCULO                     pausa / freno de emergencia (otra vez para seguir)
    SHARE + CRUZ  acostar       SHARE + TRIANGULO  levantar
    SHARE + CUADRADO  bloquear/desbloquear      SHARE + CIRCULO  recuperar (RecoveryStand)
TXT
}

corriendo() { docker ps --format '{{.Names}}' 2>/dev/null | grep -qx "$NOMBRE"; }

v1_corriendo() {
  pgrep -f "lib/go2_nav/driver" >/dev/null 2>&1 || pgrep -f "ros2 launch go2_nav" >/dev/null 2>&1
}

chequear_docker() {
  if ! command -v docker >/dev/null; then
    rojo "falta Docker: sudo apt install docker.io && sudo usermod -aG docker \$USER (y volver a entrar)"
    exit 1
  fi
  if ! docker info >/dev/null 2>&1; then
    rojo "no puedo usar Docker: sudo usermod -aG docker \$USER y cerrar sesion/volver a entrar (o reiniciar)"
    exit 1
  fi
}

interfaz_perro() { ip -o -4 addr show 2>/dev/null | awk '$4 ~ /^192\.168\.123\./ {print $2; exit}'; }

chequear_perro() {
  local i
  i=$(interfaz_perro)
  if [ -z "$i" ]; then
    rojo "ninguna interfaz con IP 192.168.123.x: conecta el cable al perro y pon tu IP en 192.168.123.100/24"
    exit 1
  fi
  if ! ping -c1 -W1 192.168.123.161 >/dev/null 2>&1; then
    amarillo "el perro (192.168.123.161) no responde al ping por $i: esta prendido?"
  fi
  local r
  r=$(sysctl -n net.core.rmem_max 2>/dev/null || echo 0)
  if [ "${r:-0}" -lt 10485760 ]; then
    amarillo "buffer de red chico (net.core.rmem_max=$r): corre 'go2v2 red' una vez (se pierden nubes)"
  fi
}

args_docker() {
  local a=(--net=host --ipc=host --privileged
           -e DISPLAY="${DISPLAY:-:0}" -e QT_X11_NO_MITSHM=1
           -e GO2_IF="$(interfaz_perro)" -e ROS_DOMAIN_ID="${ROS_DOMAIN_ID:-0}" -e PYTHONDONTWRITEBYTECODE=1
           -v /tmp/.X11-unix:/tmp/.X11-unix
           -v /dev/input:/dev/input
           -v /run/udev:/run/udev:ro
           -v "$DATOS":/root/.go2_v2
           -v "$DATOS/Desktop":/root/Desktop
           -v "$AQUI/ros_ws/src/go2_v2":/ws/src/go2_v2)
  if docker info 2>/dev/null | grep -qi "runtimes.*nvidia"; then
    a+=(--gpus all -e NVIDIA_DRIVER_CAPABILITIES=all)
  fi
  printf '%s\n' "${a[@]}"
}

correr_en_docker() {
  # correr_en_docker [-it] comando...
  local t=()
  if [ "${1:-}" = "-it" ]; then t=(-it); shift; fi
  mapfile -t A < <(args_docker)
  docker run --rm "${t[@]}" "${A[@]}" "$IMAGEN" "$@"
}

exec_en_docker() {
  if ! corriendo; then
    rojo "la v2 no esta corriendo: primero 'go2v2 lanzar' (en otra terminal)"
    exit 1
  fi
  docker exec -e GO2V2_SILENCIO=1 "$NOMBRE" /entrypoint.sh "$@"
}

servicio() {
  exec_en_docker ros2 service call "/go2/$1" std_srvs/srv/Trigger "{}" | tail -n 2
}

cmd="${1:-ayuda}"
shift || true
case "$cmd" in
  instalar)
    chequear_docker
    # restos de versiones viejas: caches de Python creados por el Docker (de root) en tu carpeta
    if find "$AQUI/ros_ws" -name __pycache__ -user root 2>/dev/null | grep -q .; then
      amarillo "borrando caches de Python que dejo el Docker (pide sudo una vez)"
      find "$AQUI/ros_ws" -name __pycache__ -user root -exec sudo rm -rf {} + 2>/dev/null
    fi
    verde "construyendo la imagen '$IMAGEN' (la primera vez tarda: compila el stack de CMU)..."
    docker build -t "$IMAGEN" -f "$AQUI/docker/Dockerfile" "$AQUI" || { rojo "fallo la construccion (mandame las ultimas lineas)"; exit 1; }
    mkdir -p "$HOME/.local/bin"
    ln -sf "$AQUI/go2v2" "$HOME/.local/bin/go2v2"
    verde "listo. Comando: go2v2 (en ~/.local/bin; si no lo encuentra, abre otra terminal)"
    [ -f "$DATOS/Desktop/imu_calib_data.yaml" ] || amarillo "falta calibrar la IMU: go2v2 calibrar"
    ;;
  red)
    echo "ajustes de red para CycloneDDS con nubes grandes (recomendados por ROS 2 / Autoware):"
    printf "net.core.rmem_max=2147483647\nnet.core.rmem_default=8388608\nnet.ipv4.ipfrag_time=3\nnet.ipv4.ipfrag_high_thresh=134217728\n" \
      | sudo tee /etc/sysctl.d/60-ros2-dds.conf
    sudo sysctl --system >/dev/null && verde "aplicado (queda guardado)"
    ;;
  calibrar)
    chequear_docker; chequear_perro
    if corriendo; then rojo "apaga la v2 primero (go2v2 detener)"; exit 1; fi
    if v1_corriendo; then rojo "la v1 (go2 lanzar) esta corriendo: cierrala primero (Ctrl+C)"; exit 1; fi
    amarillo "el perro tiene que estar DE PIE con ~1 m libre: va a dar pasitos, quedarse quieto y GIRAR 20 s"
    read -r -p "listo? [s/N] " r
    [ "$r" = "s" ] || [ "$r" = "S" ] || exit 0
    correr_en_docker -it ros2 run calibrate_imu calibrate_imu
    if [ -f "$DATOS/Desktop/imu_calib_data.yaml" ]; then
      verde "calibracion guardada en $DATOS/Desktop/imu_calib_data.yaml:"; cat "$DATOS/Desktop/imu_calib_data.yaml"
    else
      rojo "no se guardo la calibracion"
    fi
    ;;
  lanzar)
    chequear_docker; chequear_perro
    if corriendo; then rojo "ya esta corriendo (go2v2 detener para apagarla)"; exit 1; fi
    if v1_corriendo; then
      rojo "la v1 (go2 lanzar) esta corriendo: las dos le mandarian ordenes al perro. Cierrala (Ctrl+C)."
      exit 1
    fi
    [ -f "$DATOS/Desktop/imu_calib_data.yaml" ] || amarillo "SIN calibracion de la IMU: 'go2v2 calibrar' (funciona, pero peor)"
    L=()
    for a in "$@"; do
      case "$a" in
        velocidad:=*) v="${a#velocidad:=}"; L+=("maxSpeed:=$v" "autonomySpeed:=$v") ;;
        *) L+=("$a") ;;
      esac
    done
    command -v xhost >/dev/null && xhost +local:root >/dev/null 2>&1
    verde "lanzando la v2 (Ctrl+C para apagar)..."
    mapfile -t A < <(args_docker)
    docker run --rm -it --name "$NOMBRE" "${A[@]}" "$IMAGEN" ros2 launch go2_v2 go2_v2.launch "${L[@]}"
    ;;
  sim-instalar)
    f="${1:-}"
    if [ -z "$f" ] || [ ! -f "$f" ]; then
      rojo "uso: go2v2 sim-instalar ~/Downloads/ARCHIVO.zip   (el entorno de Unity bajado de la carpeta de CMU)"
      exit 1
    fi
    tmp=$(mktemp -d)
    echo "descomprimiendo $f ..."
    case "$f" in
      *.zip) unzip -q "$f" -d "$tmp" || { rojo "no pude descomprimir (sudo apt install unzip?)"; exit 1; } ;;
      *.tar.gz|*.tgz|*.tar) tar xf "$f" -C "$tmp" || { rojo "no pude descomprimir"; exit 1; } ;;
      *) rojo "formato no soportado: $f (zip o tar.gz)"; exit 1 ;;
    esac
    m=$(find "$tmp" -name Model.x86_64 -type f | head -n 1)
    if [ -z "$m" ]; then
      rojo "ese archivo no trae Model.x86_64: no es el entorno de Unity (o es el bag de ejemplo)"
      rm -rf "$tmp"; exit 1
    fi
    raiz="$(dirname "$(dirname "$m")")"        # .../unity  (adentro: environment/Model.x86_64, map.ply)
    if [ -d "$DATOS/unity" ]; then mv "$DATOS/unity" "$DATOS/unity.viejo.$(date +%s)"; fi
    mv "$raiz" "$DATOS/unity"
    rm -rf "$tmp"
    chmod +x "$DATOS/unity/environment/Model.x86_64"
    verde "entorno instalado en $DATOS/unity. Ahora: go2v2 sim"
    ;;
  sim)
    chequear_docker
    if corriendo; then rojo "ya hay una v2 corriendo (go2v2 detener)"; exit 1; fi
    UNITY="$DATOS/unity"
    if [ ! -f "$UNITY/environment/Model.x86_64" ]; then
      rojo "falta el entorno de Unity de CMU en $UNITY"
      echo "  1) bajalo (carpeta 'unity' o el zip del entorno) de:"
      echo "     https://drive.google.com/drive/folders/1CeAA5aeXCk8Sh3ZuJR7UME6sQZFuaorf"
      echo "  2) instalalo:  go2v2 sim-instalar ~/Downloads/ARCHIVO.zip"
      exit 1
    fi
    chmod +x "$UNITY/environment/Model.x86_64" 2>/dev/null
    L=()
    for a in "$@"; do
      case "$a" in
        velocidad:=*) v="${a#velocidad:=}"; L+=("maxSpeed:=$v" "autonomySpeed:=$v") ;;
        *) L+=("$a") ;;
      esac
    done
    command -v xhost >/dev/null && xhost +local:root >/dev/null 2>&1
    verde "simulacion: Unity + la v2 (Ctrl+C para apagar). Aislada del perro (dominio DDS 42)."
    mapfile -t A < <(args_docker)
    docker run --rm -it --name "$NOMBRE" "${A[@]}" -e GO2V2_SIM=1 -e ROS_DOMAIN_ID=42 \
      -v "$UNITY":/ws/src/base_autonomy/vehicle_simulator/mesh/unity \
      "$IMAGEN" bash -c '/ws/src/base_autonomy/vehicle_simulator/mesh/unity/environment/Model.x86_64 \
        > /tmp/unity.log 2>&1 & sleep 3; exec ros2 launch go2_v2 go2_v2_sim.launch "$@"' _ "${L[@]}"
    ;;
  ir|guardar|puntos|borrar|parar|estado)
    exec_en_docker ros2 run go2_v2 herramientas "$cmd" "$@"
    ;;
  acostar|levantar|bloquear|desbloquear|pausa|recuperar)
    servicio "$cmd"
    ;;
  log)
    docker logs --tail "${1:-150}" "$NOMBRE" 2>&1
    ;;
  grabar)
    s="${1:-60}"
    f="/root/.go2_v2/bags/go2_$(date +%Y%m%d_%H%M%S)"
    verde "grabando ${s} s en ${DATOS}/bags ..."
    exec_en_docker timeout "$s" ros2 bag record -o "$f" /utlidar/cloud /utlidar/imu /state_estimation /cmd_vel /joy
    ;;
  detener)
    docker stop "$NOMBRE" >/dev/null 2>&1 && verde "apagada" || echo "no estaba corriendo"
    ;;
  shell)
    if corriendo; then docker exec -it "$NOMBRE" /entrypoint.sh bash; else correr_en_docker -it bash; fi
    ;;
  ayuda|-h|--help|*)
    ayuda
    ;;
esac
