<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>go2_v2</name>
  <version>2.0.0</version>
  <description>Go2 v2: stack de CMU (Point-LIO + planificador local + FAR) con sensores vectorizados, guardian y comandos go2v2</description>
  <maintainer email="info@velkine.com">korhan</maintainer>
  <license>BSD-3-Clause</license>
  <exec_depend>rclpy</exec_depend>
  <exec_depend>std_msgs</exec_depend>
  <exec_depend>std_srvs</exec_depend>
  <exec_depend>sensor_msgs</exec_depend>
  <exec_depend>geometry_msgs</exec_depend>
  <exec_depend>nav_msgs</exec_depend>
  <exec_depend>unitree_api</exec_depend>
  <exec_depend>unitree_go</exec_depend>
  <exec_depend>robot_state_publisher</exec_depend>
  <exec_depend>tf2_ros</exec_depend>
  <exec_depend>joy</exec_depend>
  <exec_depend>point_lio_unilidar</exec_depend>
  <exec_depend>local_planner</exec_depend>
  <exec_depend>terrain_analysis</exec_depend>
  <exec_depend>terrain_analysis_ext</exec_depend>
  <exec_depend>far_planner</exec_depend>
  <exec_depend>vehicle_simulator</exec_depend>
  <exec_depend>python3-numpy</exec_depend>
  <exec_depend>python3-yaml</exec_depend>
  <export>
    <build_type>ament_python</build_type>
  </export>
</package>
